  "name": "Aula 10 - Ingestão dos convênios",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Base de convênios",
        "formDescription": "Envie os PDFs dos convênios. O envio substitui a base anterior.",
        "formFields": {
          "values": [
            {
              "fieldName": "documentos",
              "fieldLabel": "Documentos",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "base-convenios"
        }
      },
      "id": "22ac460d-f70a-510e-9f1c-ddfb5708c37a",
      "name": "Enviar convênios",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "webhookId": "3b092367-b0ff-5e16-ab83-50834a1771e5"
    },
    {
      "parameters": {
        "jsCode": "// O formulário entrega todos os PDFs num único item (Documentos_0, Documentos_1, ...).\n// Aqui cada arquivo vira um item, com o binário em \"data\" e o nome do arquivo no JSON.\nconst saida = [];\nfor (const item of $input.all()) {\n  for (const chave of Object.keys(item.binary ?? {})) {\n    const arquivo = item.binary[chave];\n    saida.push({ json: { arquivo: arquivo.fileName }, binary: { data: arquivo } });\n  }\n}\nreturn saida;"
      },
      "id": "c7a5495d-9618-5348-b4cd-1cc87d7aada4",
      "name": "Um item por arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "f2c1ae59-b026-58e8-8552-9e482834f2d3",
      "name": "Extrair texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "list",
          "value": "convenios"
        },
        "embeddingBatchSize": 50,
        "clearStore": true
      },
      "id": "4cba4997-df36-5b7f-afae-aa85de2dbafe",
      "name": "Inserir na base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        680,
